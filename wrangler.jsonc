{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "atmos-weather",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-07-28",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "atmos-weather-db",
      "database_id": "b7597f03-973a-4c94-b845-58ad6398c8a0",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "atmos-weather-media"
    }
  ]
}
