{
  "name": "atmos-weather",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "cf:types": "wrangler types",
    "cf:migrate:local": "wrangler d1 migrations apply atmos-weather-db --local",
    "cf:migrate:remote": "wrangler d1 migrations apply atmos-weather-db --remote",
    "cf:dev": "npm run build && wrangler dev",
    "cf:deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "axios": "^1.11.0",
    "tailwindcss": "^4.2.1",
    "vite": "^7.1.3",
    "vue": "^3.5.18",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260728.1",
    "typescript": "^5.9.2",
    "vue-tsc": "^3.0.6",
    "wrangler": "^4.114.0"
  }
}
